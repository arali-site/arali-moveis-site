---
import Button from "../ui/Button.astro";
import { getDictionary, getPagePath, type Locale } from "../../data/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "pt-BR" } = Astro.props;
const dict = getDictionary(locale);
---

<section class="relative h-screen min-h-[600px] flex items-end pb-24 lg:pb-32 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src="/images/projects/rdj-house/01.jpg"
      alt={dict.home.heroAlt}
      class="w-full h-full object-cover object-top"
      loading="eager"
    />
    <div class="absolute inset-0 bg-brown/60"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-2xl">
      <p class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-heading font-medium text-cream tracking-[0.2em] mb-6">
        ARALI
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-heading font-medium text-cream leading-tight mb-4">
        {dict.home.headline.map((line) => <div>{line}</div>)}
      </h1>
      <p class="text-cream/70 text-lg lg:text-xl mb-8 max-w-lg leading-relaxed">
        {dict.home.intro}
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href={getPagePath("projects", locale)} variant="primary">{dict.home.projectsCta}</Button>
        <Button href={getPagePath("contact", locale)} variant="outline" class="border-cream/50 text-cream hover:bg-cream hover:text-brown">
          {dict.home.contactCta}
        </Button>
      </div>
    </div>
  </div>
</section>
