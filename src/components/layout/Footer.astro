---
import { contact } from "../../data/contact";
---

<footer class="bg-brown text-cream/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Logo -->
    <div class="flex justify-center mb-12">
      <img src="/logos/simbolo-cream.svg" alt="Arali" class="h-16 opacity-90" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
      <!-- Contact -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6">Contato</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={`mailto:${contact.email}`} class="hover:text-cream transition-colors">
              {contact.email}
            </a>
          </li>
          <li>
            <a href={`tel:${contact.phoneRaw}`} class="hover:text-cream transition-colors">
              {contact.phone}
            </a>
          </li>
          <li>
            <a
              href={contact.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-burgundy hover:bg-burgundy-dark text-cream px-4 py-2 rounded-md text-sm transition-colors mt-2"
            >
              <iconify-icon icon="simple-icons:whatsapp" width="20" height="20"></iconify-icon>
              Fale conosco
            </a>
          </li>
        </ul>
      </div>

      <!-- Instagram -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6">
          Acompanhe nosso Instagram
        </h3>
        <a
          href={contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 hover:text-cream transition-colors text-sm"
        >
          <iconify-icon icon="simple-icons:instagram" width="20" height="20"></iconify-icon>
          {contact.instagramHandle}
        </a>
      </div>

      <!-- Address -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6 flex items-center gap-2">
          <iconify-icon icon="lucide:map-pin" width="20" height="20"></iconify-icon>
          Endereço
        </h3>
        <a
          href={contact.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm leading-relaxed hover:text-cream transition-colors block"
        >
          <p>{contact.address.street}</p>
          <p>{contact.address.neighborhood}</p>
          <p>{contact.address.city} | {contact.address.state}</p>
          <p>CEP {contact.address.cep}</p>
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-cream/50">
      <p>&copy; {new Date().getFullYear()} Arali. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
