---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/ui/SectionHeading.astro";
import { company } from "../../../data/company";
import { getDictionary } from "../../../data/i18n";

const locale = "en";
const dict = getDictionary(locale);
const companyCopy = company.en;
---

<BaseLayout title={dict.about.title} description={dict.about.description} locale={locale}>
  <!-- Page Header / Image Carousel Placeholder -->
  <section class="relative h-[50vh] min-h-[350px] overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/sobre/01.jpeg"
        alt={dict.about.heroAlt}
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-brown/50"></div>
    </div>
    <div class="relative z-10 h-full flex items-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-medium text-cream">{dict.about.heading}</h1>
      </div>
    </div>
  </section>

  <!-- About Arali -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <SectionHeading>{dict.about.aboutHeading}</SectionHeading>
          <p class="text-brown-light leading-relaxed text-lg">
            {companyCopy.history}
          </p>
        </div>
        <div>
          <img
            src="/images/sobre/02.jpeg"
            alt={dict.about.factoryAlt}
            class="w-full rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Structure and technical capacity -->
  <section class="py-16 lg:py-24 bg-brown text-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <img
            src="/images/sobre/03.jpg"
            alt={dict.about.structureAlt}
            class="w-full rounded-lg"
            loading="lazy"
          />
        </div>
        <div class="order-1 lg:order-2">
          <SectionHeading dark>
            {dict.about.structureHeading}
          </SectionHeading>
          <p class="text-cream/70 leading-relaxed text-lg">
            {companyCopy.structure}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team and execution -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <SectionHeading>
            {dict.about.teamHeading}
          </SectionHeading>
          <p class="text-brown-light leading-relaxed text-lg">
            {companyCopy.team}
          </p>
        </div>
        <div>
          <img
            src="/images/sobre/01.jpeg"
            alt={dict.about.teamAlt}
            class="w-full rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision, Values -->
  <section class="py-16 lg:py-24 bg-cream-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading align="center">
        {dict.about.missionVisionValues}
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <!-- Mission -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <iconify-icon icon="lucide:target" width="28" height="28" class="text-burgundy"></iconify-icon>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">{dict.about.mission}</h3>
          <p class="text-brown-light leading-relaxed">{companyCopy.mission}</p>
        </div>

        <!-- Vision -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <iconify-icon icon="lucide:eye" width="28" height="28" class="text-burgundy"></iconify-icon>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">{dict.about.vision}</h3>
          <p class="text-brown-light leading-relaxed">{companyCopy.vision}</p>
        </div>

        <!-- Values -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <iconify-icon icon="lucide:heart" width="28" height="28" class="text-burgundy"></iconify-icon>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">{dict.about.values}</h3>
          <ul class="text-brown-light leading-relaxed text-left space-y-1">
            {companyCopy.values.map((value: string) => (
              <li>{value}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Documents -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading>{dict.about.documents}</SectionHeading>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
        <a
          href={company.documents.codigoEtica}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-white rounded-lg shadow-sm border border-cream-dark hover:border-burgundy/30 hover:shadow-md transition-all group"
        >
          <div class="w-12 h-12 bg-burgundy/10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-burgundy/20 transition-colors">
            <iconify-icon icon="lucide:file-text" width="24" height="24" class="text-burgundy"></iconify-icon>
          </div>
          <div>
            <h4 class="font-heading font-medium text-brown group-hover:text-burgundy transition-colors">{dict.about.ethics}</h4>
            <p class="text-sm text-brown-light mt-1">{dict.about.downloadPdf}</p>
          </div>
        </a>

        <a
          href={company.documents.relatorioTransparencia}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-white rounded-lg shadow-sm border border-cream-dark hover:border-burgundy/30 hover:shadow-md transition-all group"
        >
          <div class="w-12 h-12 bg-burgundy/10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-burgundy/20 transition-colors">
            <iconify-icon icon="lucide:file-text" width="24" height="24" class="text-burgundy"></iconify-icon>
          </div>
          <div>
            <h4 class="font-heading font-medium text-brown group-hover:text-burgundy transition-colors">{dict.about.transparency}</h4>
            <p class="text-sm text-brown-light mt-1">{dict.about.downloadPdf}</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
