---
import { navLinks } from "../../data/navigation";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-transparent={transparent ? "true" : "false"}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img
          src={transparent ? "/logos/assinatura-cream.svg" : "/logos/assinatura-burgundy.svg"}
          data-src-cream="/logos/assinatura-cream.svg"
          data-src-burgundy="/logos/assinatura-burgundy.svg"
          alt="Arali"
          class="header-logo h-8 lg:h-10 w-auto transition-all duration-300"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm tracking-widest font-heading transition-colors duration-200 header-link",
              transparent
                ? (currentPath.startsWith(link.href)
                    ? "text-cream font-semibold"
                    : "text-cream/80 hover:text-cream")
                : (currentPath.startsWith(link.href)
                    ? "text-burgundy font-semibold"
                    : "text-brown hover:text-burgundy"),
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Language + Mobile Menu -->
      <div class="flex items-center gap-4">
        <div class:list={[
          "hidden lg:flex items-center gap-2 text-sm transition-colors duration-200",
          transparent ? "text-cream/70" : "text-brown-light",
        ]}>
          <span class="opacity-50 cursor-pointer hover:opacity-100 transition-opacity">EN</span>
          <span class="opacity-30">|</span>
          <span class="font-medium">PT</span>
        </div>

        <!-- Mobile Hamburger -->
        <button
          id="mobile-menu-toggle"
          class:list={[
            "lg:hidden p-2 transition-colors duration-200",
            transparent ? "text-cream" : "text-brown",
          ]}
          aria-label="Abrir menu"
          aria-expanded="false"
        >
          <iconify-icon icon="lucide:menu" width="24" height="24" class="hamburger-icon"></iconify-icon>
          <iconify-icon icon="lucide:x" width="24" height="24" class="close-icon hidden"></iconify-icon>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-cream/95 backdrop-blur-sm border-t border-cream-dark">
    <nav class="max-w-7xl mx-auto px-4 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm tracking-widest font-heading py-2 transition-colors",
            currentPath.startsWith(link.href)
              ? "text-burgundy font-semibold"
              : "text-brown hover:text-burgundy",
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-2 text-sm text-brown-light pt-2 border-t border-cream-dark">
        <span class="opacity-50 cursor-pointer hover:opacity-100">EN</span>
        <span class="opacity-30">|</span>
        <span class="font-medium">PT</span>
      </div>
    </nav>
  </div>
</header>

{!transparent && (
  <div class="h-20 lg:h-24"></div>
)}

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("mobile-menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const hamburger = toggle.querySelector(".hamburger-icon")!;
  const closeIcon = toggle.querySelector(".close-icon")!;
  const isTransparent = header.dataset.transparent === "true";

  function updateHeader() {
    const scrolled = window.scrollY > 20;

    if (scrolled) {
      header.classList.add("bg-cream/95", "backdrop-blur-sm", "shadow-sm");
      if (isTransparent) {
        header.querySelectorAll(".header-link").forEach((link) => {
          link.classList.remove("text-cream", "text-cream/80", "hover:text-cream");
          link.classList.add("text-brown", "hover:text-burgundy");
        });
        const logo = header.querySelector(".header-logo") as HTMLImageElement | null;
        if (logo) {
          const burgundy = logo.dataset.srcBurgundy;
          if (burgundy) logo.src = burgundy;
        }
        toggle.classList.remove("text-cream");
        toggle.classList.add("text-brown");
      }
    } else {
      header.classList.remove("bg-cream/95", "backdrop-blur-sm", "shadow-sm");
      if (isTransparent) {
        header.querySelectorAll(".header-link").forEach((link) => {
          link.classList.add("text-cream/80", "hover:text-cream");
          link.classList.remove("text-brown", "hover:text-burgundy");
        });
        const logo = header.querySelector(".header-logo") as HTMLImageElement | null;
        if (logo) {
          const cream = logo.dataset.srcCream;
          if (cream) logo.src = cream;
        }
        toggle.classList.add("text-cream");
        toggle.classList.remove("text-brown");
      }
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  toggle.addEventListener("click", () => {
    const isOpen = !menu.classList.contains("hidden");
    menu.classList.toggle("hidden");
    hamburger.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
