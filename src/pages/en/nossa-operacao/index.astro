---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/ui/SectionHeading.astro";
import Button from "../../../components/ui/Button.astro";
import { contact } from "../../../data/contact";
import { getDictionary } from "../../../data/i18n";

const locale = "en";
const dict = getDictionary(locale);
---

<BaseLayout title={dict.operation.title} description={dict.operation.description} locale={locale}>
  <!-- Page Header -->
  <section class="py-12 lg:py-20 bg-burgundy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading dark>{dict.operation.heading}</SectionHeading>
      <p class="text-cream/70 max-w-2xl text-lg leading-relaxed">
        {dict.operation.intro}
      </p>
      <p class="text-cream/50 max-w-2xl leading-relaxed mt-2">
        {dict.operation.subintro}
      </p>
    </div>
  </section>

  <!-- Main Block — Instagram CTA -->
  <section class="py-20 lg:py-32">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Instagram Icon -->
      <div class="mb-8 flex justify-center">
        <iconify-icon icon="simple-icons:instagram" width="64" height="64" class="text-burgundy"></iconify-icon>
      </div>

      <h2 class="text-2xl sm:text-3xl font-heading font-medium text-brown mb-4">
        {dict.operation.processTitle}
      </h2>
      <p class="text-brown-light text-lg leading-relaxed mb-8">
        {dict.operation.processCopy}
      </p>
      <Button
        href={contact.instagram}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
      >
        <iconify-icon icon="simple-icons:instagram" width="20" height="20"></iconify-icon>
        {dict.operation.instagramCta}
      </Button>
      <p class="text-brown-light/60 text-sm mt-4">{contact.instagramHandle}</p>
    </div>
  </section>

  <!-- Team & Operation Gallery -->
  <section class="pb-16 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <img
          src="/images/operacao/01.jpg"
          alt={dict.operation.imageAlts[0]}
          class="w-full aspect-square object-cover rounded-lg"
          loading="lazy"
        />
        <img
          src="/images/operacao/02.jpg"
          alt={dict.operation.imageAlts[1]}
          class="w-full aspect-square object-cover rounded-lg"
          loading="lazy"
        />
        <img
          src="/images/operacao/03.webp"
          alt={dict.operation.imageAlts[2]}
          class="w-full aspect-square object-cover rounded-lg"
          loading="lazy"
        />
        <img
          src="/images/operacao/04.jpg"
          alt={dict.operation.imageAlts[3]}
          class="w-full aspect-square object-cover rounded-lg"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
