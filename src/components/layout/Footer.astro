---
import { contact } from "../../data/contact";
---

<footer class="bg-brown text-cream/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Logo -->
    <div class="flex justify-center mb-12">
      <img src="/logos/simbolo-cream.svg" alt="Arali" class="h-16 opacity-90" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
      <!-- Contact -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6">Contato</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={`mailto:${contact.email}`} class="inline-flex items-start gap-3 hover:text-cream transition-colors">
              <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center leading-none">
                <iconify-icon icon="lucide:mail" width="20" height="20"></iconify-icon>
              </span>
              <span>{contact.email}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${contact.phoneRaw}`} class="inline-flex items-start gap-3 hover:text-cream transition-colors">
              <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center leading-none">
                <iconify-icon icon="lucide:phone" width="20" height="20"></iconify-icon>
              </span>
              <span>{contact.phone}</span>
            </a>
          </li>
          <li>
            <a
              href={contact.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-burgundy hover:bg-burgundy-dark text-cream px-4 py-2 rounded-md text-sm transition-colors mt-2"
            >
              <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center leading-none">
                <iconify-icon icon="simple-icons:whatsapp" width="18" height="18"></iconify-icon>
              </span>
              Fale Conosco
            </a>
          </li>
        </ul>
      </div>

      <!-- Instagram -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6">
          Acompanhe nosso Instagram
        </h3>
        <a
          href={contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 hover:text-cream transition-colors text-sm"
        >
          <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center leading-none">
            <iconify-icon icon="simple-icons:instagram" width="18" height="18"></iconify-icon>
          </span>
          {contact.instagramHandle}
        </a>
      </div>

      <!-- Address -->
      <div>
        <h3 class="text-cream font-heading text-sm tracking-widest uppercase mb-6">Endereço</h3>
        <a
          href={contact.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-3 text-sm leading-relaxed hover:text-cream transition-colors"
        >
          <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center leading-none">
            <iconify-icon icon="lucide:map-pin" width="20" height="20"></iconify-icon>
          </span>
          <span>
            <span class="block">{contact.address.street}</span>
            <span class="block">{contact.address.neighborhood}</span>
            <span class="block">{contact.address.city} | {contact.address.state}</span>
            <span class="block">CEP {contact.address.cep}</span>
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-cream/50">
      <p>&copy; {new Date().getFullYear()} Arali. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
