---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/ui/SectionHeading.astro";
import Button from "../../../components/ui/Button.astro";
import { contact } from "../../../data/contact";
import { getDictionary } from "../../../data/i18n";

const locale = "en";
const dict = getDictionary(locale);
---

<BaseLayout title={dict.contact.title} description={dict.contact.description} locale={locale}>
  <!-- Page Header -->
  <section class="py-12 lg:py-20 bg-burgundy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading dark>{dict.contact.heading}</SectionHeading>
      <p class="text-cream/70 max-w-2xl text-lg leading-relaxed">
        {dict.contact.intro}
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div>
          <h3 class="text-xl font-heading font-medium text-brown mb-6">{dict.contact.formTitle}</h3>
          <form class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-brown-light mb-1">{dict.contact.labels.name}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                  placeholder={dict.contact.placeholders.name}
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-brown-light mb-1">{dict.contact.labels.phone}</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                  placeholder={dict.contact.placeholders.phone}
                />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-brown-light mb-1">{dict.contact.labels.email}</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                placeholder={dict.contact.placeholders.email}
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-brown-light mb-1">{dict.contact.labels.subject}</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                placeholder={dict.contact.placeholders.subject}
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-brown-light mb-1">{dict.contact.labels.message}</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors resize-vertical"
                placeholder={dict.contact.placeholders.message}
              ></textarea>
            </div>
            <Button variant="primary">{dict.contact.submit}</Button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-6">{dict.contact.infoTitle}</h3>
            <ul class="space-y-4 text-brown-light">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center text-burgundy leading-none">
                  <iconify-icon icon="lucide:mail" width="20" height="20"></iconify-icon>
                </span>
                <a href={`mailto:${contact.email}`} class="hover:text-burgundy transition-colors">
                  {contact.email}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center text-burgundy leading-none">
                  <iconify-icon icon="lucide:phone" width="20" height="20"></iconify-icon>
                </span>
                <a href={`tel:${contact.phoneRaw}`} class="hover:text-burgundy transition-colors">
                  {contact.phone}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center text-burgundy leading-none">
                  <iconify-icon icon="simple-icons:whatsapp" width="18" height="18"></iconify-icon>
                </span>
                <div>
                  <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-burgundy transition-colors block">
                    WhatsApp — {contact.whatsappPhone}
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Address -->
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-4">{dict.contact.address}</h3>
            <a
              href={contact.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3 text-brown-light hover:text-burgundy transition-colors leading-relaxed"
            >
              <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center text-burgundy leading-none">
                <iconify-icon icon="lucide:map-pin" width="20" height="20"></iconify-icon>
              </span>
              <span>
                <span class="block">{contact.address.street}</span>
                <span class="block">{contact.address.neighborhood}</span>
                <span class="block">{contact.address.city} | {contact.address.state}</span>
                <span class="block">{dict.common.postalCode} {contact.address.cep}</span>
              </span>
            </a>
          </div>

          <!-- Instagram -->
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-4">{dict.contact.instagram}</h3>
            <a
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-burgundy hover:text-burgundy-dark transition-colors"
            >
              <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center text-burgundy leading-none">
                <iconify-icon icon="simple-icons:instagram" width="18" height="18"></iconify-icon>
              </span>
              {contact.instagramHandle}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Maps -->
  <section class="pb-0">
    <iframe
      src={contact.address.embedUrl}
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={dict.contact.mapTitle}
      class="w-full"
    ></iframe>
  </section>
</BaseLayout>
