---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getDictionary, getPagePath, localizeProjectData } from "../../../data/i18n";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = "en";
const dict = getDictionary(locale);
const data = localizeProjectData(project.data, locale);
const { title, location, architect, interiors, description, images } = data;
---

<BaseLayout title={`${title} — Arali`} description={description || dict.projects.fallbackDescription(title)} locale={locale}>
  <div class="bg-burgundy min-h-screen">
    <!-- Back Link -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <a href={getPagePath("projects", locale)} class="inline-flex items-center gap-2 text-cream/60 hover:text-cream transition-colors text-sm font-body">
        <iconify-icon icon="lucide:arrow-left" width="16" height="16"></iconify-icon>
        {dict.projects.back}
      </a>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
        <!-- Hero Image -->
        <div class="lg:w-2/3">
          <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-burgundy-dark">
            <img
              id="main-image"
              src={images[0]}
              alt={title}
              class="w-full h-full object-cover transition-opacity duration-300"
            />
          </div>
        </div>

        <!-- Info Sidebar -->
        <div class="lg:w-1/3 flex flex-col justify-center">
          <h1 class="font-heading text-3xl lg:text-4xl font-bold text-cream tracking-tight">
            {title}
          </h1>

          <div class="mt-6 space-y-3">
            {location && (
              <div>
                <span class="text-cream/40 text-xs uppercase tracking-wider font-heading">{dict.projects.labels.location}</span>
                <p class="text-cream/80 text-sm mt-0.5">{location}</p>
              </div>
            )}

            {architect && (
              <div>
                <span class="text-cream/40 text-xs uppercase tracking-wider font-heading">{dict.projects.labels.architect}</span>
                <p class="text-cream/80 text-sm mt-0.5">{architect}</p>
              </div>
            )}

            {interiors && (
              <div>
                <span class="text-cream/40 text-xs uppercase tracking-wider font-heading">{dict.projects.labels.interiors}</span>
                <p class="text-cream/80 text-sm mt-0.5">{interiors}</p>
              </div>
            )}
          </div>

          {description && (
            <p class="text-cream/60 text-sm leading-relaxed mt-6">
              {description}
            </p>
          )}

          <div class="mt-6 text-cream/30 text-xs font-heading">
            <span id="image-counter">1</span> / {images.length}
          </div>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div class="mt-8 lg:mt-12">
        <div class="flex gap-2 overflow-x-auto scrollbar-hide pb-4" id="thumbnail-strip">
          {images.map((image, index) => (
            <button
              data-gallery-thumb={image}
              data-index={index}
              class:list={[
                "flex-shrink-0 w-24 h-18 lg:w-32 lg:h-24 rounded overflow-hidden transition-all duration-200 cursor-pointer",
                index === 0 ? "ring-2 ring-cream" : "ring-2 ring-transparent opacity-60 hover:opacity-100"
              ]}
            >
              <img
                src={image}
                alt={dict.projects.photoAlt(title, index + 1)}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const mainImage = document.getElementById('main-image') as HTMLImageElement;
  const counter = document.getElementById('image-counter')!;
  const thumbnails = document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
  const strip = document.getElementById('thumbnail-strip')!;
  let currentIndex = 0;

  function switchImage(index: number) {
    if (index < 0 || index >= thumbnails.length || index === currentIndex) return;

    const thumb = thumbnails[index];
    const src = thumb.dataset.galleryThumb!;

    mainImage.style.opacity = '0';
    setTimeout(() => {
      mainImage.src = src;
      mainImage.alt = thumb.querySelector('img')?.alt || '';
      mainImage.style.opacity = '1';
    }, 200);

    thumbnails.forEach(t => {
      t.classList.remove('ring-cream');
      t.classList.add('ring-transparent', 'opacity-60');
    });
    thumb.classList.remove('ring-transparent', 'opacity-60');
    thumb.classList.add('ring-cream');

    currentIndex = index;
    counter.textContent = String(index + 1);

    thumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  }

  thumbnails.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      switchImage(Number(thumb.dataset.index));
    });

    thumb.addEventListener('mouseenter', () => {
      const img = new Image();
      img.src = thumb.dataset.galleryThumb!;
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      switchImage(currentIndex + 1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      switchImage(currentIndex - 1);
    }
  });
</script>
