---
import { company } from "../../data/company";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { getDictionary, getPagePath, type Locale } from "../../data/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "pt-BR" } = Astro.props;
const dict = getDictionary(locale);
const fsc = locale === "en" ? company.en.fsc : company.fsc;
---

<section class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image -->
      <div class="relative">
        <img
          src="/images/fsc/selo-fsc.jpg"
          alt={dict.home.fsc.imageAlt}
          class="w-full rounded-lg shadow-lg"
          loading="lazy"
        />
      </div>

      <!-- Content -->
      <div>
        <SectionHeading>
          {dict.home.fsc.title}
        </SectionHeading>
        <p class="text-brown-light leading-relaxed mb-6">
          {fsc.description_1}
        </p>
        <p class="text-brown-light leading-relaxed mb-6">
          {fsc.description_2}
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href={company.fsc.link} variant="outline">
            {dict.home.fsc.learnMore}
          </Button>
          <Button href={getPagePath("operation", locale)} variant="primary">
            {dict.home.fsc.operation}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
