---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import { company } from "../../data/company";
---

<BaseLayout title="Sobre Nós — Arali Móveis" description="Conheça a história da Arali Móveis. Fundada em 2011, somos referência em marcenaria de alto padrão.">
  <!-- Page Header / Image Carousel Placeholder -->
  <section class="relative h-[50vh] min-h-[350px] overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/rdj-house/04.jpg"
        alt="Arali Móveis — Sobre Nós"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-brown/50"></div>
    </div>
    <div class="relative z-10 h-full flex items-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-medium text-cream">Sobre Nós</h1>
      </div>
    </div>
  </section>

  <!-- Sobre a Arali -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <SectionHeading>Sobre a Arali</SectionHeading>
          <p class="text-brown-light leading-relaxed text-lg">
            {company.history}
          </p>
        </div>
        <div>
          <img
            src="/images/projects/rdj-house/03.jpg"
            alt="Fábrica Arali Móveis"
            class="w-full rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Estrutura e capacidade técnica -->
  <section class="py-16 lg:py-24 bg-brown text-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <img
            src="/images/projects/rdj-house/01.jpg"
            alt="Estrutura e capacidade técnica"
            class="w-full rounded-lg"
            loading="lazy"
          />
        </div>
        <div class="order-1 lg:order-2">
          <SectionHeading dark>
            Estrutura e capacidade técnica
          </SectionHeading>
          <p class="text-cream/70 leading-relaxed text-lg">
            {company.structure}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipe e execução -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <SectionHeading>
            Equipe e execução
          </SectionHeading>
          <p class="text-brown-light leading-relaxed text-lg">
            {company.team}
          </p>
        </div>
        <div>
          <img
            src="/images/projects/rdj-house/02.jpg"
            alt="Equipe Arali Móveis"
            class="w-full rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision, Values -->
  <section class="py-16 lg:py-24 bg-cream-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading align="center">
        Missão, Visão e Valores
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <!-- Mission -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">Missão</h3>
          <p class="text-brown-light leading-relaxed">{company.mission}</p>
        </div>

        <!-- Vision -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">Visão</h3>
          <p class="text-brown-light leading-relaxed">{company.vision}</p>
        </div>

        <!-- Values -->
        <div class="bg-white rounded-lg p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-burgundy/10 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <h3 class="text-lg font-heading font-semibold text-burgundy uppercase tracking-wider mb-4">Valores</h3>
          <ul class="text-brown-light leading-relaxed text-left space-y-1">
            {company.values.map((value: string) => (
              <li>{value}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Documents -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading>Documentos</SectionHeading>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
        <a
          href={company.documents.codigoEtica}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-white rounded-lg shadow-sm border border-cream-dark hover:border-burgundy/30 hover:shadow-md transition-all group"
        >
          <div class="w-12 h-12 bg-burgundy/10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-burgundy/20 transition-colors">
            <svg class="w-6 h-6 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-medium text-brown group-hover:text-burgundy transition-colors">Nosso Código de Ética e Conduta</h4>
            <p class="text-sm text-brown-light mt-1">Baixar PDF</p>
          </div>
        </a>

        <a
          href={company.documents.relatorioTransparencia}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-white rounded-lg shadow-sm border border-cream-dark hover:border-burgundy/30 hover:shadow-md transition-all group"
        >
          <div class="w-12 h-12 bg-burgundy/10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-burgundy/20 transition-colors">
            <svg class="w-6 h-6 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-medium text-brown group-hover:text-burgundy transition-colors">Relatório de Transparência e Igualdade Salarial</h4>
            <p class="text-sm text-brown-light mt-1">Baixar PDF</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
