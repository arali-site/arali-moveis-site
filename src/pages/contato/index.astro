---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import { contact } from "../../data/contact";
---

<BaseLayout title="Contato — Arali" description="Entre em contato com a Arali. Fale conosco por telefone, WhatsApp ou visite nosso escritório.">
  <!-- Page Header -->
  <section class="py-12 lg:py-20 bg-burgundy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading dark>Fale conosco</SectionHeading>
      <p class="text-cream/70 max-w-2xl text-lg leading-relaxed">
        Entre em contato para conhecer nossas soluções em marcenaria de alto padrão.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div>
          <h3 class="text-xl font-heading font-medium text-brown mb-6">Envie uma mensagem</h3>
          <form class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-brown-light mb-1">Seu nome</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                  placeholder="Nome completo"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-brown-light mb-1">Telefone</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                  placeholder="(00) 00000-0000"
                />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-brown-light mb-1">E-mail *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                placeholder="seu@email.com"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-brown-light mb-1">Assunto *</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors"
                placeholder="Assunto da mensagem"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-brown-light mb-1">Mensagem *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border border-cream-dark rounded-md bg-white text-brown placeholder-brown-light/40 focus:outline-none focus:ring-2 focus:ring-burgundy/30 focus:border-burgundy transition-colors resize-vertical"
                placeholder="Digite aqui a sua mensagem..."
              ></textarea>
            </div>
            <Button variant="primary">Enviar mensagem</Button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-6">Informações de contato</h3>
            <ul class="space-y-4 text-brown-light">
              <li class="flex items-start gap-3">
                <iconify-icon icon="lucide:mail" width="20" height="20" class="mt-0.5 text-burgundy flex-shrink-0"></iconify-icon>
                <a href={`mailto:${contact.email}`} class="hover:text-burgundy transition-colors">
                  {contact.email}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <iconify-icon icon="lucide:phone" width="20" height="20" class="mt-0.5 text-burgundy flex-shrink-0"></iconify-icon>
                <a href={`tel:${contact.phoneRaw}`} class="hover:text-burgundy transition-colors">
                  {contact.phone}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <iconify-icon icon="simple-icons:whatsapp" width="20" height="20" class="mt-0.5 text-burgundy flex-shrink-0"></iconify-icon>
                <div>
                  <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-burgundy transition-colors block">
                    WhatsApp — {contact.whatsappPhone}
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Address -->
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-4 flex items-center gap-2">
              <iconify-icon icon="lucide:map-pin" width="20" height="20" class="text-burgundy"></iconify-icon>
              Endereço
            </h3>
            <a
              href={contact.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brown-light hover:text-burgundy transition-colors block leading-relaxed"
            >
              <p>{contact.address.street}</p>
              <p>{contact.address.neighborhood}</p>
              <p>{contact.address.city} | {contact.address.state}</p>
              <p>CEP {contact.address.cep}</p>
            </a>
          </div>

          <!-- Instagram -->
          <div>
            <h3 class="text-xl font-heading font-medium text-brown mb-4">Acompanhe nosso Instagram</h3>
            <a
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-burgundy hover:text-burgundy-dark transition-colors"
            >
              <iconify-icon icon="simple-icons:instagram" width="20" height="20"></iconify-icon>
              {contact.instagramHandle}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Maps -->
  <section class="pb-0">
    <iframe
      src={contact.address.embedUrl}
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Localização Arali"
      class="w-full"
    ></iframe>
  </section>
</BaseLayout>
